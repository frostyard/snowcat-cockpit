{
  "schema_version": 1,
  "default_decision": "deny",
  "actions": {
    "read": "allow",
    "write": "allow",
    "run-tests": "allow",
    "open-issue": "review-required",
    "open-pr": "review-required",
    "create-followup": "review-required"
  },
  "protected_boundaries": [
    {
      "id": "workflow-and-permissions",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".github/workflows/**"
      ],
      "detectors": []
    },
    {
      "id": "release-and-publication",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".goreleaser.yaml",
        ".svu.yaml",
        ".github/workflows/release.yml",
        ".github/workflows/snapshot.yml",
        ".github/workflows/worker-images.yml"
      ],
      "detectors": []
    },
    {
      "id": "credentials-and-sensitive-data",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "oci/**",
        "bin/**",
        "internal/worker/**",
        "internal/leaseproxy/**",
        "internal/profile/**",
        "internal/preflight/**"
      ],
      "detectors": []
    },
    {
      "id": "authentication",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "internal/web/**"
      ],
      "detectors": []
    },
    {
      "id": "deployment-and-infrastructure",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "internal/nodeservice/**",
        "cmd/**"
      ],
      "detectors": []
    }
  ],
  "change_controls": {
    "pull_requests_required": true,
    "human_review_before_merge": true,
    "highest_applicable_risk": true,
    "validation_evidence_required": true,
    "least_privilege": true,
    "untrusted_content_is_data": true,
    "never_relax": [
      "required-checks",
      "security-checks",
      "review-requirements",
      "coverage-checks",
      "provenance-verification"
    ]
  },
  "exception_controls": {
    "independent_authorized_approver": true,
    "self_approval": false,
    "required_fields": [
      "rationale",
      "target",
      "compensating-controls",
      "expires-at",
      "restoration-or-closure-plan"
    ]
  },
  "risk_classification": {
    "tiers": [
      "low",
      "moderate",
      "high",
      "critical"
    ],
    "classification_rule": "highest-applicable",
    "uncertainty_rule": "higher-plausible"
  }
}
