# One worker base, three provider targets (ADR-0012 §1).
#
# Every provider image is the `base` stage plus a two-line final stage that
# pins its entrypoint, so the three published images share every layer and
# one digest lineage. Build a provider with `--target codex|claude|copilot`.
# The base's guaranteed command baseline is enumerated once, in
# oci/baseline.json — keep the two in step.

# ---- provider CLIs, each fetched at its pin and checksum-verified (core ADR-0023)

FROM docker.io/library/node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS node

RUN npm install --global @openai/codex@0.149.0 \
    && npm cache clean --force

FROM docker.io/library/golang:1.26.7-bookworm@sha256:6ef6e30f0ea5c384f6d111cf856e024e3086bbdcb1779da3f3b3fbba0aea53d2 AS fetch

# No default: buildx sets TARGETARCH per platform, and a default here would
# override it — the v0.1.3 arm64 build fetched amd64 binaries that way (the
# earlier per-provider files had the same default and never executed what
# they fetched, so it went unseen). Local builds pass it explicitly.
ARG TARGETARCH
ARG CLAUDE_VERSION=2.1.239
ARG COPILOT_VERSION=1.0.80
ARG MISE_VERSION=2026.8.12
RUN case "$TARGETARCH" in \
      amd64) claude_arch=x64; claude_sum=7de1b1576e2e0be73ce91c2b4dedf16a41058ea633b957a36fdc6044ddfc0f3c; \
             copilot_arch=x64; copilot_sum=039933c9247686131c4406abb1d439bdbf68103edc1ff585bd70d5b0dc940f72; \
             mise_arch=x64; mise_sum=0c782233b97745fd3ed317ba3acbfd7d256e6268470373757f0cc48d57bb87e6 ;; \
      arm64) claude_arch=arm64; claude_sum=66f202c9b52a13318aa7d55e180130fb95ced04af6dc46fd1ea823b598f35556; \
             copilot_arch=arm64; copilot_sum=3ed85e711955e13be523bf492bc6c93b40b69925bcb7f817c9d08abf4839cf89; \
             mise_arch=arm64; mise_sum=3ec7d4fd8ebd923794612a3cc89cb44617943845ebf0f4cea9a325dbb3756184 ;; \
      *) printf 'unsupported TARGETARCH: %s\n' "$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --show-error --output /usr/local/bin/claude \
      "https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/linux-${claude_arch}/claude" \
    && printf '%s  %s\n' "$claude_sum" /usr/local/bin/claude | sha256sum --check --strict \
    && chmod 0755 /usr/local/bin/claude \
    && curl --fail --location --show-error --output /tmp/copilot.tar.gz \
      "https://github.com/github/copilot-cli/releases/download/v${COPILOT_VERSION}/copilot-linux-${copilot_arch}.tar.gz" \
    && printf '%s  %s\n' "$copilot_sum" /tmp/copilot.tar.gz | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/copilot.tar.gz --directory /usr/local/bin copilot \
    && chmod 0755 /usr/local/bin/copilot \
    && curl --fail --location --show-error --output /tmp/mise.tar.gz \
      "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${mise_arch}.tar.gz" \
    && printf '%s  %s\n' "$mise_sum" /tmp/mise.tar.gz | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/mise.tar.gz --directory /tmp \
    && install -m 0755 /tmp/mise/bin/mise /usr/local/bin/mise \
    && /usr/local/bin/mise version >/dev/null

# ---- the base every provider image is

FROM docker.io/library/golang:1.26.7-bookworm@sha256:6ef6e30f0ea5c384f6d111cf856e024e3086bbdcb1779da3f3b3fbba0aea53d2 AS base

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      bsdextrautils \
      ca-certificates \
      curl \
      gh \
      git \
      jq \
      make \
      openssh-client \
      patch \
      ripgrep \
      unzip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --home-dir /home/cockpit --shell /bin/bash --uid 1000 cockpit \
    && install -d -o cockpit -g cockpit -m 0700 \
      /home/cockpit/.config/gh \
      /home/cockpit/.codex \
      /home/cockpit/.claude \
      /home/cockpit/.copilot \
      /run/cockpit/input/codex /run/cockpit/input/gh /workspace \
    && install -d -m 0755 /usr/local/share/snowcat-cockpit /var/lib/snowcat-cockpit/mise \
    && ln -s /usr/local/go/bin/go /usr/local/bin/go \
    && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node /usr/local/lib/node_modules/@openai/codex /usr/local/lib/node_modules/@openai/codex
COPY --from=fetch /usr/local/bin/claude /usr/local/bin/claude
COPY --from=fetch /usr/local/bin/copilot /usr/local/bin/copilot
COPY --from=fetch /usr/local/bin/mise /usr/local/bin/mise
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --chmod=0644 oci/baseline.json /usr/local/share/snowcat-cockpit/baseline.json
# Provisioned repository tools resolve through mise shims in the read-only
# cache (ADR-0012 §2). Providers run repository commands through a login
# shell, and Debian's /etc/profile resets PATH, so the shims directory is
# prepended by profile.d as well as by ENV; it is harmless when empty.
RUN printf 'PATH=/var/lib/snowcat-cockpit/mise/shims:$PATH\nexport PATH\n' > /etc/profile.d/snowcat-cockpit-mise.sh \
    && chmod 0644 /etc/profile.d/snowcat-cockpit-mise.sh
COPY --chmod=0644 oci/claude-system-prompt.txt /usr/local/share/snowcat-cockpit/claude-system-prompt.txt
COPY --chmod=0755 oci/entrypoint.sh /usr/local/bin/cockpit-entrypoint-codex
COPY --chmod=0755 oci/claude-entrypoint.sh /usr/local/bin/cockpit-entrypoint-claude
COPY --chmod=0755 oci/copilot-entrypoint.sh /usr/local/bin/cockpit-entrypoint-copilot

# GOPATH and GOCACHE live under /tmp, the one tmpfs the launch mounts exec:
# Docker mounts the home tmpfs noexec, and Go executes from both (go tool
# covdata, $GOPATH/bin, cached tool builds); every worker on the Docker node
# was rediscovering that inside its lease (issue #15).
# GOTOOLCHAIN=local: a go.mod the image's Go cannot satisfy fails at the first
# go invocation instead of downloading a toolchain inside a lease. MISE_DATA_DIR
# is the read-only per-repository tool cache Cockpit mounts at target
# preparation (ADR-0012 §2); it is empty in the image.
ENV PATH=/var/lib/snowcat-cockpit/mise/shims:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/home/cockpit \
    CODEX_HOME=/home/cockpit/.codex \
    CLAUDE_CONFIG_DIR=/home/cockpit/.claude \
    CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 \
    COPILOT_HOME=/home/cockpit/.copilot \
    GH_CONFIG_DIR=/home/cockpit/.config/gh \
    GOPATH=/tmp/go \
    GOCACHE=/tmp/go-build \
    GOTOOLCHAIN=local \
    MISE_DATA_DIR=/var/lib/snowcat-cockpit/mise \
    MISE_CACHE_DIR=/home/cockpit/.cache/mise \
    MISE_YES=1

USER 1000:1000
WORKDIR /workspace

# ---- provider images: the base plus an entrypoint

FROM base AS codex
ENTRYPOINT ["/usr/local/bin/cockpit-entrypoint-codex"]

FROM base AS claude
ENTRYPOINT ["/usr/local/bin/cockpit-entrypoint-claude"]

FROM base AS copilot
ENTRYPOINT ["/usr/local/bin/cockpit-entrypoint-copilot"]
