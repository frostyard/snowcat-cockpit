#!/usr/bin/env bash
set -euo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly MCP_URL="https://snowcat.goat-snake.ts.net/mcp"
readonly MCP_HOST="snowcat.goat-snake.ts.net"

CREDENTIAL_FILE="${SNOWCAT_COCKPIT_OBSERVER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/snowcat/profile-observer.env}"
COCKPIT_BIN="${SNOWCAT_COCKPIT_BIN:-$PROJECT_ROOT/dist/snowcat-cockpit}"

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

file_stat() {
  local format_linux=$1
  local format_darwin=$2
  local path=$3
  stat -c "$format_linux" -- "$path" 2>/dev/null || stat -f "$format_darwin" "$path" 2>/dev/null
}

[[ -f "$CREDENTIAL_FILE" ]] || die "observer credential file is missing: $CREDENTIAL_FILE"
[[ ! -L "$CREDENTIAL_FILE" ]] || die "observer credential file must not be a symbolic link"

credential_mode="$(file_stat '%a' '%Lp' "$CREDENTIAL_FILE")" || die "cannot inspect observer credential permissions"
[[ "$credential_mode" == "600" ]] || die "observer credential file must have mode 0600 (found $credential_mode)"

credential_owner="$(file_stat '%u' '%u' "$CREDENTIAL_FILE")" || die "cannot inspect observer credential owner"
[[ "$credential_owner" == "$(id -u)" ]] || die "observer credential file must be owned by the current user"

observer_token=""
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    'export SNOWCAT_OBSERVER_TOKEN='*)
      [[ -z "$observer_token" ]] || die "observer credential file declares SNOWCAT_OBSERVER_TOKEN more than once"
      observer_token="${line#export SNOWCAT_OBSERVER_TOKEN=}"
      ;;
  esac
done <"$CREDENTIAL_FILE"

[[ "$observer_token" =~ ^snowcat_[[:alnum:]_-]+$ ]] || die "observer credential file has an invalid SNOWCAT_OBSERVER_TOKEN"
[[ -x "$COCKPIT_BIN" ]] || die "Cockpit binary is not executable: $COCKPIT_BIN (run make build)"

if [[ -n "${SNOWCAT_COCKPIT_OCI_IMAGE:-}${SNOWCAT_COCKPIT_OCI_CODEX_IMAGE:-}${SNOWCAT_COCKPIT_OCI_CLAUDE_IMAGE:-}${SNOWCAT_COCKPIT_OCI_COPILOT_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_CODEX_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_CLAUDE_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_COPILOT_IMAGE:-}" && -z "${GH_TOKEN:-}" ]]; then
  command -v gh >/dev/null 2>&1 || die "OCI workers require gh to project a GitHub token"
  GH_TOKEN="$(gh auth token)" || die "OCI workers require a valid GitHub CLI login"
  [[ -n "$GH_TOKEN" && "$GH_TOKEN" != *$'\n'* && "$GH_TOKEN" != *$'\r'* ]] || die "GitHub CLI returned an invalid token"
  export GH_TOKEN
fi

export SNOWCAT_MCP_URL="$MCP_URL"

if [[ -n "${SNOWCAT_COCKPIT_DOCKER_CODEX_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_CLAUDE_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_COPILOT_IMAGE:-}" ]]; then
  if [[ -z "${SNOWCAT_COCKPIT_DOCKER_ADD_HOST:-}" ]]; then
    command -v getent >/dev/null 2>&1 || die "Docker workers require getent to resolve the Snowcat tailnet endpoint"
    docker_host_address=""
    while read -r address _; do
      if [[ "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        docker_host_address="$address"
        break
      fi
    done < <(getent ahostsv4 "$MCP_HOST")
    [[ -n "$docker_host_address" ]] || die "Docker workers could not resolve the Snowcat tailnet endpoint"
    export SNOWCAT_COCKPIT_DOCKER_ADD_HOST="$MCP_HOST:$docker_host_address"
    unset docker_host_address
  fi
fi

export SNOWCAT_COCKPIT_MCP_URL="$MCP_URL"
export SNOWCAT_COCKPIT_MCP_TOKEN="$observer_token"
unset observer_token SNOWCAT_OBSERVER_TOKEN

exec "$COCKPIT_BIN" serve "$@"
