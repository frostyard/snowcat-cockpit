#!/usr/bin/env bash
set -euo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly MCP_URL="https://snowcat.frostyard.org/mcp"

OBSERVER_CREDENTIAL_FILE="${SNOWCAT_COCKPIT_OBSERVER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/snowcat/profile-observer.env}"
WORKER_CREDENTIAL_FILE="${SNOWCAT_COCKPIT_WORKER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/snowcat/mcp-token.env}"
COCKPIT_BIN="${SNOWCAT_COCKPIT_BIN:-$PROJECT_ROOT/dist/snowcat-cockpit}"

die() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

file_stat() {
  local format_linux=$1
  local format_darwin=$2
  local path=$3
  stat -c "$format_linux" -- "$path" 2>/dev/null || stat -f "$format_darwin" "$path" 2>/dev/null
}

validate_credential_file() {
  local label=$1
  local path=$2
  local credential_mode credential_owner

  [[ -f "$path" ]] || die "$label credential file is missing: $path"
  [[ ! -L "$path" ]] || die "$label credential file must not be a symbolic link"
  credential_mode="$(file_stat '%a' '%Lp' "$path")" || die "cannot inspect $label credential permissions"
  [[ "$credential_mode" == "600" ]] || die "$label credential file must have mode 0600 (found $credential_mode)"
  credential_owner="$(file_stat '%u' '%u' "$path")" || die "cannot inspect $label credential owner"
  [[ "$credential_owner" == "$(id -u)" ]] || die "$label credential file must be owned by the current user"
}

validate_credential_file observer "$OBSERVER_CREDENTIAL_FILE"
validate_credential_file worker "$WORKER_CREDENTIAL_FILE"

observer_token=""
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    'export SNOWCAT_OBSERVER_TOKEN='*)
      [[ -z "$observer_token" ]] || die "observer credential file declares SNOWCAT_OBSERVER_TOKEN more than once"
      observer_token="${line#export SNOWCAT_OBSERVER_TOKEN=}"
      ;;
  esac
done <"$OBSERVER_CREDENTIAL_FILE"

[[ "$observer_token" =~ ^snowcat_[[:alnum:]_-]+$ ]] || die "observer credential file has an invalid SNOWCAT_OBSERVER_TOKEN"

worker_token=""
access_client_id=""
access_client_secret=""
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    'export SNOWCAT_MCP_TOKEN='*)
      [[ -z "$worker_token" ]] || die "worker credential file declares SNOWCAT_MCP_TOKEN more than once"
      worker_token="${line#export SNOWCAT_MCP_TOKEN=}"
      ;;
    'export CF_ACCESS_CLIENT_ID='*)
      [[ -z "$access_client_id" ]] || die "worker credential file declares CF_ACCESS_CLIENT_ID more than once"
      access_client_id="${line#export CF_ACCESS_CLIENT_ID=}"
      ;;
    'export CF_ACCESS_CLIENT_SECRET='*)
      [[ -z "$access_client_secret" ]] || die "worker credential file declares CF_ACCESS_CLIENT_SECRET more than once"
      access_client_secret="${line#export CF_ACCESS_CLIENT_SECRET=}"
      ;;
  esac
done <"$WORKER_CREDENTIAL_FILE"

[[ "$worker_token" =~ ^snowcat_[[:alnum:]_-]+$ ]] || die "worker credential file has an invalid SNOWCAT_MCP_TOKEN"
[[ "$access_client_id" =~ ^[[:alnum:]._-]+$ ]] || die "worker credential file has an invalid CF_ACCESS_CLIENT_ID"
[[ "$access_client_secret" =~ ^[[:alnum:]_-]+$ ]] || die "worker credential file has an invalid CF_ACCESS_CLIENT_SECRET"
[[ -x "$COCKPIT_BIN" ]] || die "Cockpit binary is not executable: $COCKPIT_BIN (run make build)"

if [[ -n "${SNOWCAT_COCKPIT_OCI_IMAGE:-}${SNOWCAT_COCKPIT_OCI_CODEX_IMAGE:-}${SNOWCAT_COCKPIT_OCI_CLAUDE_IMAGE:-}${SNOWCAT_COCKPIT_OCI_COPILOT_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_CODEX_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_CLAUDE_IMAGE:-}${SNOWCAT_COCKPIT_DOCKER_COPILOT_IMAGE:-}" && -z "${GH_TOKEN:-}" ]]; then
  command -v gh >/dev/null 2>&1 || die "OCI workers require gh to project a GitHub token"
  GH_TOKEN="$(gh auth token)" || die "OCI workers require a valid GitHub CLI login"
  [[ -n "$GH_TOKEN" && "$GH_TOKEN" != *$'\n'* && "$GH_TOKEN" != *$'\r'* ]] || die "GitHub CLI returned an invalid token"
  export GH_TOKEN
fi

export SNOWCAT_MCP_URL="$MCP_URL"
export SNOWCAT_MCP_TOKEN="$worker_token"
export SNOWCAT_CF_ACCESS_CLIENT_ID="$access_client_id"
export SNOWCAT_CF_ACCESS_CLIENT_SECRET="$access_client_secret"

export SNOWCAT_COCKPIT_MCP_URL="$MCP_URL"
export SNOWCAT_COCKPIT_MCP_TOKEN="$observer_token"
unset observer_token worker_token access_client_id access_client_secret
unset SNOWCAT_OBSERVER_TOKEN CF_ACCESS_CLIENT_ID CF_ACCESS_CLIENT_SECRET

exec "$COCKPIT_BIN" serve "$@"
